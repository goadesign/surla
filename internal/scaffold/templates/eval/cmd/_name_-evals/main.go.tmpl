// Command [[.Name]]-evals is the starter evaluator suite for the [[.Name]]. surla verify
// builds and runs it following Surla's suite command contract
// (github.com/goadesign/surla/verify/suite): --describe prints the declared
// scenarios, and --artifact [[.Name]]=<path> runs them against that binary.
// The project server runs --live for start_live_target, using its selected model.
package main

import (
	"context"
	"errors"
	"fmt"
	"os"

	"goa.design/goa-ai/eval"
	"goa.design/goa-ai/features/model/anthropic"
	"goa.design/goa-ai/features/model/openai"
	"goa.design/goa-ai/runtime/agent/model"

	"github.com/goadesign/surla/verify/candidate"
	"github.com/goadesign/surla/verify/suite"

	"[[.Module]]/eval/acceptance"
	genevals "[[.Module]]/eval/gen/evals/[[.Name]]_acceptance"
)

func main() {
	suite.Main(suite.Command{
		Environment:    "scripted-model",
		Binaries:       []string{acceptance.Name},
		MaxConcurrency: 2,
		Declare: func() (eval.Suite, error) {
			return genevals.New(&acceptance.Hooks{}, genevals.Inputs{})
		},
		Suite: func(pinned map[string]candidate.Artifact) (eval.Suite, error) {
			return genevals.New(acceptance.New(pinned[acceptance.Name]), genevals.Inputs{})
		},
		Live: func(ctx context.Context, pinned map[string]candidate.Artifact, key string) (suite.LiveTarget, error) {
			return live(ctx, pinned[acceptance.Name], key, os.Getenv)
		},
	})
}

// live starts the [[.Name]] for CP3 with the project server's selected gateway
// or direct provider and model. Provider keys stay in this process.
func live(ctx context.Context, binary candidate.Artifact, key string, getenv func(string) string) (suite.LiveTarget, error) {
	gatewayAddr := getenv("SURLA_LIVE_MODEL_GATEWAY")
	providerName, modelName := getenv("SURLA_LIVE_MODEL_PROVIDER"), getenv("SURLA_LIVE_MODEL_NAME")
	switch {
	case gatewayAddr != "" && (providerName != "" || modelName != ""):
		return suite.LiveTarget{}, errors.New("the live [[.Name]] got both a model gateway and a model provider; the Surla project server passes only one")
	case gatewayAddr != "":
		return acceptance.LiveThroughGateway(ctx, binary, key, gatewayAddr)
	case providerName == "" && modelName == "":
		return suite.LiveTarget{}, errors.New("no model for the live [[.Name]]: ask the user to configure a model in Surla")
	case providerName == "" || modelName == "":
		return suite.LiveTarget{}, errors.New("the live [[.Name]] needs both a model provider and a model name; ask the user to configure a provider and model in Surla")
	}
	provider, err := liveProvider(providerName, modelName, getenv)
	if err != nil {
		return suite.LiveTarget{}, err
	}
	return acceptance.Live(ctx, binary, key, provider)
}

// liveProvider builds the selected provider from its inherited API key.
func liveProvider(providerName, modelName string, getenv func(string) string) (model.Provider, error) {
	switch providerName {
	case "anthropic":
		return anthropic.NewProviderFromAPIKey(getenv("ANTHROPIC_API_KEY"), modelName)
	case "openai":
		return openai.NewProviderFromAPIKey(getenv("OPENAI_API_KEY"), modelName)
	default:
		return nil, fmt.Errorf("unsupported model provider %q for the live [[.Name]]", providerName)
	}
}

// Package design is the evaluator's own copy of the [[.Name]]'s public contract and
// the starter acceptance suite. The evaluator generates its HTTP client from
// this copy and never imports code from the [[.Name]] module it tests.
package design

import (
	. "goa.design/goa-ai/dsl"
	. "goa.design/goa-ai/eval/dsl"
	. "goa.design/goa/v3/dsl"
)

var _ = API("[[.Name]]", func() {
	Title("[[.Name]] (public contract as the evaluator sees it)")
})

// LiveKey is the [[.Name]]'s live key, as the evaluator sees it.
var LiveKey = APIKeySecurity("live_key")

var _ = Service("[[.Name]]", func() {
	Error("unauthorized", String, "The key is missing or wrong.")
	Error("unknown_prompt", ErrorResult, "No prompt with this ID is registered.")
	Error("invalid_prompt", ErrorResult, "The template does not render.")

	Method("override_prompt", func() {
		Security(LiveKey)
		Payload(func() {
			APIKey("live_key", "key", String, "The [[.Name]]'s live key.")
			Attribute("prompt_id", String, "Registered prompt to replace.")
			Attribute("template", String, "New prompt text.")
			Required("key", "prompt_id", "template")
		})
		Result(func() {
			Attribute("prompt_id", String, "The prompt whose text was replaced.")
			Attribute("version", String, "Version of the accepted text.")
			Required("prompt_id", "version")
		})
		HTTP(func() {
			PUT("/prompts/{prompt_id}")
			Header("key:X-Live-Target-Key")
			Body(func() {
				Attribute("template")
			})
			Response(StatusOK)
			Response("unauthorized", StatusUnauthorized)
			Response("unknown_prompt", StatusNotFound)
			Response("invalid_prompt", StatusUnprocessableEntity)
		})
	})

	Method("ask", func() {
		Payload(func() {
			Attribute("question", String, "Question to answer.")
			Required("question")
		})
		Result(func() {
			Attribute("answer", String, "The agent's final answer.")
			Attribute("run_id", String, "Identifier of the agent run.")
			Required("answer", "run_id")
		})
		HTTP(func() {
			POST("/ask")
		})
	})
})

// This starter suite lives in the same repository as the [[.Name]], so anyone who
// can read the [[.Name]]'s code can read these scenarios too; none of them is
// hidden. Surla generates the suite's program, gen/cmd/[[.Name]]-evals, from this
// suite and the acceptance package.
var _ = Suite("[[.Name]]_acceptance", func() {
	Description("Proves through the public API that the helper agent prices items with its lookup_price tool, and that override_prompt changes the prompt the next model request carries.")
	Timeout("1m")

	Scenario("prices_tea", func() {
		Description("Asking \"How much is tea?\" makes the agent call lookup_price for tea and answer with the returned 350 cents as $3.50.")
		Tags("repair")
	})
	Scenario("prompt_override_reaches_model", func() {
		Description("override_prompt with the live key replaces the helper's system prompt, a wrong key is rejected, and the next question's model request carries the new text.")
		Tags("repair")
	})
	Scenario("unknown_item", func() {
		Description("Asking about coffee, which the catalog does not price, makes the agent call lookup_price and report that it found no price.")
		Tags("repair")
	})
})

// Package design declares the [[.Name]] service: a public API, a pricing method,
// a helper agent that answers price questions by calling the pricing method
// as a tool, and the prompt operation Surla's live CP3 drafts call. goa gen generates the HTTP server, the agent's typed
// client and tool bindings, and the C4 model from this package.
package design

import (
	. "goa.design/goa-ai/dsl"
	. "goa.design/goa/v3/dsl"
)

var _ = API("[[.Name]]", func() {
	Title("[[.Name]]")
	Description("Answers price questions with an agent that looks prices up through a tool.")
})

// LiveKey is the key Surla mints for a live CP3 target and passes to the
// [[.Name]] through its environment. Only override_prompt requires it.
var LiveKey = APIKeySecurity("live_key", func() {
	Description("Key Surla minted for this process and passed to it at start.")
})

// catalog is the toolset the helper agent may call.
var catalog = Toolset("catalog", func() {
	Description("Look up the price of an item.")

	Tool("lookup_price", "Look up one item's price in cents; known is false when the catalog has no price for it.", func() {
		Args(func() {
			Attribute("item", String, "Item to price, such as tea.", func() { MinLength(1) })
			Required("item")
		})
		Return(Price)
		BindTo("[[.Name]]", "price")
	})
})

var _ = Service("[[.Name]]", func() {
	Description("Answers price questions.")

	Method("ask", func() {
		Description("Ask the helper agent a question; it may look prices up before answering.")
		Payload(func() {
			Attribute("question", String, "Question to answer, such as \"How much is tea?\".", func() { MinLength(1) })
			Required("question")
		})
		Result(func() {
			Attribute("answer", String, "The agent's final answer.")
			Attribute("run_id", String, "Identifier of the agent run that produced the answer.")
			Required("answer", "run_id")
		})
		HTTP(func() {
			POST("/ask")
		})
	})

	Method("price", func() {
		Description("Look up the price of one item. An item the catalog does not price is an expected answer (known is false), not an error. The helper agent calls this method through the lookup_price tool.")
		Payload(func() {
			Attribute("item", String, "Item to price.", func() { MinLength(1) })
			Required("item")
		})
		Result(Price)
		HTTP(func() {
			GET("/prices/{item}")
		})
	})

	Method("override_prompt", func() {
		Description("Replace the text of a registered prompt for every question this process answers, until it exits. Surla's draft_override calls it on a live CP3 target. The template must render with the prompt's registered spec, so text that does not render is rejected and the text in use stays the same.")
		Security(LiveKey)
		Error("unauthorized", String, "The key is missing or is not this process's key.")
		Error("unknown_prompt", ErrorResult, "No prompt with this ID is registered.")
		Error("invalid_prompt", ErrorResult, "The template does not render with the prompt's registered spec.")
		Payload(func() {
			APIKey("live_key", "key", String, "This process's live key.")
			Attribute("prompt_id", String, "Registered prompt to replace, such as [[.Name]].helper.system.", func() { MinLength(1) })
			Attribute("template", String, "New prompt text, as a Go text/template.", func() { MinLength(1) })
			Required("prompt_id", "template")
		})
		Result(func() {
			Attribute("prompt_id", String, "The prompt whose text was replaced.")
			Attribute("version", String, "Version of the accepted text.")
			Required("prompt_id", "version")
		})
		HTTP(func() {
			PUT("/prompts/{prompt_id}")
			Header("key:X-Live-Target-Key")
			Body(func() {
				Attribute("template")
			})
			Response(StatusOK)
			Response("unauthorized", StatusUnauthorized)
			Response("unknown_prompt", StatusNotFound)
			Response("invalid_prompt", StatusUnprocessableEntity)
		})
	})

	Export(catalog)

	Agent("helper", "Answers price questions using the catalog.", func() {
		Use(catalog)
		RunPolicy(func() {
			DefaultCaps(MaxToolCalls(4), MaxRecoveryTurns(1))
			TimeBudget("1m")
		})
	})
})

// Price is the catalog's answer for one item.
var Price = Type("Price", func() {
	Attribute("item", String, "Item that was looked up.")
	Attribute("known", Boolean, "Whether the catalog has a price for the item.")
	Attribute("cents", Int, "Price in cents; 0 when known is false.")
	Required("item", "known", "cents")
})

// Package service implements the [[.Name]] service: ask answers a question
// with the helper agent, price looks items up in a fixed catalog, and
// override_prompt replaces the helper's prompt text while the process runs.
package service

import (
	"context"
	"crypto/rand"
	"crypto/subtle"
	"errors"
	"fmt"
	"time"

	"goa.design/goa-ai/runtime/agent/model"
	"goa.design/goa-ai/runtime/agent/prompt"
	"goa.design/goa-ai/runtime/agent/runtime"
	storageinmem "goa.design/goa-ai/runtime/agent/storage/inmem"
	"goa.design/goa/v3/security"

	gen[[.Pkg]] "[[.Module]]/gen/[[.Pkg]]"
	gen[[.Pkg]]helper "[[.Module]]/gen/[[.Pkg]]/agents/helper"
	gen[[.Pkg]]helpercatalog "[[.Module]]/gen/[[.Pkg]]/agents/helper/catalog"
	"[[.Module]]/internal/helper"
)

// Service implements gen[[.Pkg]].Service.
type Service struct {
	// model is the model client every agent step uses; it outlives
	// questions.
	model model.Client
	// prompts holds the prompt text override_prompt sets. It is the only
	// state shared across questions: each question's runtime reads it, and
	// it lives as long as the process, keeping every accepted text.
	prompts *prompt.InMemoryStore
	// liveKey is the key override_prompt requires; empty accepts no key.
	liveKey string
}

// modelID is the runtime's name for the model client.
const modelID = "default"

// catalog is the price of every known item, in cents.
var catalog = map[string]int{
	"tea":    350,
	"cookie": 125,
}

// New returns the [[.Name]] service. mc is the model client the helper agent
// plans with. liveKey is the key override_prompt requires; when it is empty,
// override_prompt rejects every call.
func New(mc model.Client, liveKey string) *Service {
	return &Service{model: mc, prompts: prompt.NewInMemoryStore(), liveKey: liveKey}
}

// Ask answers the question with the helper agent and returns its final
// answer. Each question gets its own in-memory runtime, store and session,
// all released once the answer is returned: nothing asks for an earlier
// run, so nothing is kept.
func (s *Service) Ask(ctx context.Context, p *gen[[.Pkg]].AskPayload) (*gen[[.Pkg]].AskResult, error) {
	store := storageinmem.New()
	rt := runtime.New(store, runtime.WithPromptStore(s.prompts))
	if err := rt.PromptRegistry.Register(helper.SystemPrompt()); err != nil {
		return nil, fmt.Errorf("register system prompt: %w", err)
	}
	if err := rt.RegisterModel(modelID, s.model); err != nil {
		return nil, fmt.Errorf("register model: %w", err)
	}
	if err := gen[[.Pkg]]helper.RegisterHelperAgent(ctx, rt, gen[[.Pkg]]helper.HelperAgentConfig{Planner: helper.NewPlanner(modelID)}); err != nil {
		return nil, fmt.Errorf("register helper agent: %w", err)
	}
	endpoints := gen[[.Pkg]].NewEndpoints(s)
	tools := gen[[.Pkg]].NewClient(endpoints.Ask, endpoints.Price, endpoints.OverridePrompt)
	if err := gen[[.Pkg]]helper.RegisterUsedToolsets(ctx, rt,
		gen[[.Pkg]]helper.WithCatalogExecutor(gen[[.Pkg]]helpercatalog.NewHelperCatalogExec(gen[[.Pkg]]helpercatalog.WithClient(tools))),
	); err != nil {
		return nil, fmt.Errorf("register catalog tools: %w", err)
	}
	if err := rt.Seal(ctx); err != nil {
		return nil, fmt.Errorf("seal runtime: %w", err)
	}
	sessionID := "session-" + rand.Text()
	if _, err := store.CreateSession(ctx, sessionID, time.Now().UTC()); err != nil {
		return nil, fmt.Errorf("create session: %w", err)
	}
	out, err := gen[[.Pkg]]helper.NewClient(rt).Run(ctx, sessionID, []*model.Message{{
		Role:  model.ConversationRoleUser,
		Parts: []model.Part{model.TextPart{Text: p.Question}},
	}}, runtime.WithRunID("run-"+rand.Text()))
	if err != nil {
		return nil, fmt.Errorf("run helper agent: %w", err)
	}
	if out.Final == nil {
		return nil, errors.New("helper agent finished without an answer")
	}
	return &gen[[.Pkg]].AskResult{Answer: out.Final.Text(), RunID: out.RunID}, nil
}

// OverridePrompt replaces the text of the helper's system prompt for every
// later question. It renders the template with the registered spec and no
// data before saving it, so a template that does not render is rejected and
// the text in use stays the same. It returns the accepted text's version.
func (s *Service) OverridePrompt(ctx context.Context, p *gen[[.Pkg]].OverridePromptPayload) (*gen[[.Pkg]].OverridePromptResult, error) {
	spec := helper.SystemPrompt()
	if prompt.Ident(p.PromptID) != spec.ID {
		return nil, gen[[.Pkg]].MakeUnknownPrompt(fmt.Errorf("no prompt %q is registered", p.PromptID))
	}
	spec.Template = p.Template
	check := prompt.NewRegistry(nil)
	if err := check.Register(spec); err != nil {
		return nil, gen[[.Pkg]].MakeInvalidPrompt(err)
	}
	if _, err := check.Render(ctx, spec.ID, prompt.Scope{}, nil); err != nil {
		return nil, gen[[.Pkg]].MakeInvalidPrompt(err)
	}
	if err := s.prompts.Set(ctx, spec.ID, prompt.Scope{}, p.Template, nil); err != nil {
		return nil, fmt.Errorf("save prompt text: %w", err)
	}
	return &gen[[.Pkg]].OverridePromptResult{PromptID: p.PromptID, Version: prompt.VersionFromTemplate(p.Template)}, nil
}

// APIKeyAuth accepts only the live key the process started with.
func (s *Service) APIKeyAuth(ctx context.Context, key string, _ *security.APIKeyScheme) (context.Context, error) {
	if s.liveKey == "" || subtle.ConstantTimeCompare([]byte(key), []byte(s.liveKey)) != 1 {
		return ctx, gen[[.Pkg]].Unauthorized("missing or wrong live key")
	}
	return ctx, nil
}

// Price returns the catalog price of the item. An item the catalog does not
// price is reported with Known false, not as an error.
func (s *Service) Price(_ context.Context, p *gen[[.Pkg]].PricePayload) (*gen[[.Pkg]].Price, error) {
	cents, known := catalog[p.Item]
	return &gen[[.Pkg]].Price{Item: p.Item, Known: known, Cents: cents}, nil
}
